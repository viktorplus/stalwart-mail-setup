# The primary configuration file holds the administrator password.
# Only mailserver.conf.example belongs in git.
mailserver.conf

# Generated from mailserver.conf at setup time.
compose/.env
compose/Caddyfile
compose/fail2ban/jail.d/snappymail.local

# Generated mailbox passwords.
mailbox-passwords.txt

# Generated SnappyMail admin panel key.
snappymail-admin-key.txt

# Runtime state.
compose/caddy_data/
compose/caddy_config/
compose/snappymail_data/
plans/
*.key
*.pem

# Python bytecode
__pycache__/
*.pyc
