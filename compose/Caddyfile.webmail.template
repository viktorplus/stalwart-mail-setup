
# Webmail. Appended to the generated Caddyfile only when webmail_host is set
# in mailserver.conf.
{{WEBMAIL_HOST}} {
	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}

	# SnappyMail takes the client address from Client-IP before
	# X-Forwarded-For. Drop it so a client cannot forge the address that
	# lands in auth.log; X-Forwarded-For is set by Caddy itself.
	reverse_proxy snappymail:8888 {
		header_up -Client-IP
	}
}
